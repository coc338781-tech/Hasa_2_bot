# Central API configuration. Keep secrets in the deployment secret manager.
HASA_OWNER_ACCESS_KEY=
DATABASE_URL=
# Generate with: openssl rand -base64 32. API-only key; never copy it to worker servers.
HASA_PAIRING_CODE_KEY=
HASA_API_HOST=127.0.0.1
HASA_API_PORT=8787
# Fallback only if the database setting is unavailable; the owner controls the live reserve in /owner (default 768 MiB).
HASA_MIN_FREE_MEMORY_BYTES=805306368
